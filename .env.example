# --- Client-side (VITE_ prefix -> shipped in the browser bundle, safe to expose) ---

# Supabase is Storage-only now (DB + Auth moved to Neon). Keep pointed at
# the existing Supabase project so the watches/watch-images/brands buckets
# keep working.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only needed if the API is ever hosted on a different origin
# than the frontend. Defaults to `${window.location.origin}/api/auth`.
# VITE_BETTER_AUTH_URL=

# --- Netlify Functions only (site environment variables, never VITE_-prefixed, never sent to the browser) ---

# Neon Postgres connection string used by Prisma (pooled/-pooler host
# recommended for serverless function concurrency).
DATABASE_URL=

# Random secret Better Auth uses to sign/encrypt sessions -- generate with
# e.g. `openssl rand -base64 32`. Keep this out of git and rotate it if it
# ever leaks (rotating invalidates all existing sessions).
BETTER_AUTH_SECRET=

# The canonical base URL of this deployment (e.g.
# https://your-site.netlify.app), used internally by Better Auth for
# cookie/redirect handling.
BETTER_AUTH_URL=

# --- Client-side (VITE_ prefix -> shipped in the browser bundle, safe to expose) ---

# Supabase is Storage-only now (DB + Auth moved to Neon). Keep pointed at
# the existing Supabase project so the watches/watch-images/brands buckets
# keep working.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only needed if the API is ever hosted on a different origin
# than the frontend. Defaults to `${window.location.origin}/api/auth`.
# VITE_BETTER_AUTH_URL=

# --- Netlify Functions only (site environment variables, never VITE_-prefixed, never sent to the browser) ---

# Neon Postgres connection string used by Prisma (pooled/-pooler host
# recommended for serverless function concurrency).
#
# Dev workflow: locally, point this at the Neon `development` branch
# (a copy-on-write clone of production created for this purpose), NOT
# at production. Netlify injects the context-correct value automatically
# on deploy (production DB for the master/production context, the
# `development` branch DB for the dev branch-deploy) via per-context
# scoped env vars in Site settings, so this file/your local .env only
# ever needs to carry the dev-branch value.
DATABASE_URL=

# Random secret Better Auth uses to sign/encrypt sessions -- generate with
# e.g. `openssl rand -base64 32`. Keep this out of git and rotate it if it
# ever leaks (rotating invalidates all existing sessions).
#
# Dev workflow: use a SEPARATE secret from production (generate a second
# one for the dev context) so dev sessions/tokens are cryptographically
# isolated from prod.
BETTER_AUTH_SECRET=

# The canonical base URL of this deployment (e.g.
# https://your-site.netlify.app), used internally by Better Auth for
# cookie/redirect handling.
#
# Dev workflow: for local dev use your local origin (or leave unset to
# default to window.location.origin/api/auth); the dev branch-deploy's
# Netlify env var should be scoped to that deploy's own URL
# (Netlify's `dev--<site-name>.netlify.app` pattern), not production's.
BETTER_AUTH_URL=

# --- New migration authoring loop (dev branch + Neon branch DB) ---
# 1. Point DATABASE_URL above at the Neon `development` branch.
# 2. Run `npx prisma migrate dev --name <description>` to create and
#    apply a new migration against that branch DB.
# 3. Commit the generated prisma/migrations/<...> folder, push via a
#    feature branch, PR into `dev`.
# 4. Merging into `dev` triggers Netlify's dev branch-deploy, whose
#    build runs `prisma migrate deploy` against the dev branch DB
#    (validates the migration applies cleanly from a fresh context).
# 5. Once verified, PR `dev` -> `master`; that deploy's build applies
#    the same, already-proven migration to the production DB.
